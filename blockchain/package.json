{
  "name": "blue-reef-blockchain",
  "version": "1.0.0",
  "description": "Smart contracts for Blue Reef Registry",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:moonbeam": "hardhat run scripts/deploy.ts --network moonbeam",
    "deploy:moonbase": "hardhat run scripts/deploy.ts --network moonbase",
    "deploy:moonriver": "hardhat run scripts/deploy.ts --network moonriver",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "node": "hardhat node",
    "verify": "hardhat verify",
    "verify:moonbeam": "hardhat verify --network moonbeam",
    "verify:moonbase": "hardhat verify --network moonbase"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@types/node": "^20.0.0",
    "hardhat": "^2.19.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.3",
    "@moonbeam-network/api-augment": "^0.2700.0",
    "dotenv": "^16.0.0",
    "ethers": "^6.9.0"
  }
}
